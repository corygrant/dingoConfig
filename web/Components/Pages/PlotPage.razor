@page "/plot"
@using application.Services
@using web.Services
@inject PlotService PlotService
@inject IJSRuntime JS
@inject IDialogService DialogService
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Plot</PageTitle>

<div class="d-flex" style="height: calc(100vh - 64px);">
    @* Chart *@
    <div class="d-flex flex-column pa-2" style="flex: 1 1 auto; min-width: 0;">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
            <MudButton Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="SelectSignalsAsync">
                Signals
            </MudButton>

            <MudDivider Vertical="true" FlexItem="true"/>

            <MudButton Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.FiberManualRecord"
                       Disabled="@(PlotService.State == RecordingState.Recording)"
                       OnClick="PlotService.StartRecording">
                Record
            </MudButton>
            <MudButton Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Pause"
                       Disabled="@(PlotService.State != RecordingState.Recording)"
                       OnClick="PlotService.PauseRecording">
                Pause
            </MudButton>
            <MudButton Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Stop"
                       Disabled="@(PlotService.State == RecordingState.Stopped)"
                       OnClick="PlotService.StopRecording">
                Stop
            </MudButton>

            <MudDivider Vertical="true" FlexItem="true"/>

            <div style="width: 120px;">
                <MudSelect T="int" Value="_windowSeconds" ValueChanged="SetWindowAsync" Label="Window"
                           Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                    @foreach (var (seconds, label) in Windows)
                    {
                        <MudSelectItem Value="seconds">@label</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudTooltip Text="@(_follow ? "Following live data. Drag on the chart to zoom." : "Zoomed. Double-click the chart or press here to follow live data again.")">
                <MudToggleIconButton Toggled="_follow" ToggledChanged="SetFollowAsync"
                                     Icon="@Icons.Material.Filled.PauseCircleOutline" ToggledIcon="@Icons.Material.Filled.PlayCircleOutline"
                                     Color="Color.Default" ToggledColor="Color.Primary" Size="Size.Small"/>
            </MudTooltip>

            <MudSpacer/>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@(_stateText = StateText())</MudText>
        </MudStack>

        @if (_traces.Count > 0)
        {
            <div class="d-flex flex-wrap mb-1" style="gap: 4px;">
                @foreach (var trace in _traces)
                {
                    var signal = PlotService.GetSignal(trace.Key);
                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small"
                             OnClose="() => PlotService.RemoveTrace(trace.Key)">
                        <span class="plot-swatch" style="background: @trace.Color;"></span>
                        @signal?.FullLabel
                    </MudChip>
                }
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">
                Press Signals to choose what to plot, then Record. Each unit is drawn in its own pane;
                drag across a pane to zoom, double-click to return to live data.
            </MudText>
        }

        @* uPlot owns everything inside this element; Blazor must not render children into it *@
        <div @ref="_chartHost" class="app-plot" style="flex: 1 1 auto; min-height: 0; position: relative;"></div>
    </div>
</div>

@code {
    private const int UpdateIntervalMs = 100;

    private static readonly (int Seconds, string Label)[] Windows =
    [
        (10, "10 s"), (30, "30 s"), (60, "1 min"), (120, "2 min"), (300, "5 min"), (0, "All")
    ];

    private ElementReference _chartHost;
    private IJSObjectReference? _module;
    private IJSObjectReference? _plot;
    private DotNetObjectReference<PlotPage>? _dotNetRef;
    private Timer? _timer;
    private bool _updating;
    private bool _disposed;

    private IReadOnlyList<PlotTrace> _traces = [];
    private int _tracesVersion = -1;
    private int _signalsVersion = -1;
    private string _stateText = "";
    private int _generation = -1;
    private long _seq;
    private int _windowSeconds = 60;
    private bool _follow = true;

    protected override void OnInitialized()
    {
        _traces = PlotService.GetTraces();
        _signalsVersion = PlotService.SignalsVersion;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", PlotInterop.ModulePath);
            _plot = await _module.InvokeAsync<IJSObjectReference>("createAppPlot", _chartHost, _dotNetRef);
            await _plot.InvokeVoidAsync("setWindow", _windowSeconds);
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        if (_disposed) return;
        _timer = new Timer(_ => InvokeAsync(UpdateAsync), null, 0, UpdateIntervalMs);
    }

    private async Task UpdateAsync()
    {
        if (_plot is null || _updating || _disposed) return;
        _updating = true;

        try
        {
            var render = false;

            if (_signalsVersion != PlotService.SignalsVersion)
            {
                _signalsVersion = PlotService.SignalsVersion;
                render = true;
            }

            var keys = _traces.Select(t => t.Key).ToList();

            if (_tracesVersion != PlotService.TracesVersion)
            {
                // Traces or recording state changed (possibly from another browser tab): rebuild the chart
                _tracesVersion = PlotService.TracesVersion;
                _traces = PlotService.GetTraces();
                keys = _traces.Select(t => t.Key).ToList();

                var chunk = PlotService.Recording.Read(keys, -1, 0);
                (_generation, _seq) = (chunk.Generation, chunk.Seq);

                var traces = _traces.Select(t => PlotService.GetSignal(t.Key) is { } s
                    ? new { key = t.Key, label = s.FullLabel, unit = s.Unit, color = t.Color, discrete = s.IsDiscrete }
                    : null).OfType<object>().ToList();

                await _plot.InvokeVoidAsync("setTraces", traces, PlotService.Recording.Capacity, chunk);
                render = true;
            }
            else if (keys.Count > 0)
            {
                var chunk = PlotService.Recording.Read(keys, _generation, _seq);
                (_generation, _seq) = (chunk.Generation, chunk.Seq);

                if (chunk.Reset || chunk.Times.Length > 0)
                    await _plot.InvokeVoidAsync("push", chunk);
            }

            if (StateText() != _stateText) render = true;
            if (render) StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            _updating = false;
        }
    }

    private async Task SelectSignalsAsync()
    {
        var parameters = new DialogParameters<PlotSignalSelectionDialog>
        {
            { x => x.Selected, _traces.Select(t => t.Key).ToList() }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<PlotSignalSelectionDialog>("Select Signals", parameters, options);
        if (await dialog.Result is not { Canceled: false, Data: List<string> keys }) return;

        foreach (var trace in _traces.Where(t => !keys.Contains(t.Key)))
            PlotService.RemoveTrace(trace.Key);
        foreach (var key in keys)
            PlotService.AddTrace(key);

        // Show the change immediately rather than on the next tick
        _traces = PlotService.GetTraces();
    }

    private async Task SetWindowAsync(int seconds)
    {
        _windowSeconds = seconds;
        if (_plot is not null) await _plot.InvokeVoidAsync("setWindow", seconds);
    }

    private async Task SetFollowAsync(bool follow)
    {
        _follow = follow;
        if (_plot is not null) await _plot.InvokeVoidAsync("setFollow", follow);
    }

    [JSInvokable]
    public void OnFollowChanged(bool follow)
    {
        _follow = follow;
        StateHasChanged();
    }

    private string StateText()
    {
        var seconds = PlotService.Recording.Count / (double)PlotService.SampleRateHz;
        var held = TimeSpan.FromSeconds(Math.Min(seconds, PlotService.RecordSeconds));
        return PlotService.State switch
        {
            RecordingState.Recording => $"Recording · {held:m\\:ss} (last {PlotService.RecordSeconds / 60} min kept)",
            RecordingState.Paused => $"Paused · {held:m\\:ss}",
            _ => "Stopped"
        };
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_timer is not null) await _timer.DisposeAsync();

        try
        {
            if (_plot is not null)
            {
                await _plot.InvokeVoidAsync("dispose");
                await _plot.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _dotNetRef?.Dispose();
    }
}
