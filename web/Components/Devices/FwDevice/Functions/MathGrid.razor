@using domain.Devices.Functions
@using domain.Enums
@typeparam TDevice where TDevice : domain.Interfaces.IDeviceConfigurable
@inherits FunctionComponentBase<TDevice>

<MudDataGrid Items="@MathBlocks" Dense="true" Hover="true" Striped="false" EditMode="DataGridEditMode.Cell" ReadOnly="false"
             SortMode="SortMode.None" ColumnResizeMode="ResizeMode.Container" Virtualize="true"
             FixedHeader="true" HorizontalScrollbar="true" Style="max-height: 400px;">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="#" StickyLeft="true" Editable="false" CellStyle="max-width: 100px"/>
        <PropertyColumn Property="x => x.Enabled" CellStyle="max-width: 100px">
            <EditTemplate>
                <MudCheckBox @bind-Value="context.Item.Enabled" Dense="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Name" CellStyle="max-width: 200px">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Value" Title="Value" Editable="false" CellStyle="max-width: 100px">
            <CellTemplate>@context.Item.Value.ToString("0.###")</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.InputA" Title="A" CellStyle="max-width: 250px;">
            <EditTemplate>
                <MudStack Row="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="(!context.Item.Enabled)"
                                   Style="max-width: 20px"
                                   OnClick="@(() => OpenVariableSelectorAsync(["bool", "int", "float"], v => context.Item.InputA = v))">
                    </MudIconButton>
                    <MudText>@GetSelectedVarText(context.Item.InputA)</MudText>
                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Operation" Title="Op" CellStyle="max-width: 150px">
            <EditTemplate>
                <MudSelect T="MathOp" @bind-Value="context.Item.Operation" Variant="Variant.Outlined" Dense="true"
                           Disabled="!context.Item.Enabled">
                    @foreach (MathOp op in Enum.GetValues(typeof(MathOp)))
                    {
                        <MudSelectItem T="MathOp" Value="@op">@op</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.InputB" Title="B" CellStyle="max-width: 250px;">
            <EditTemplate>
                <MudStack Row="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="(!context.Item.Enabled)"
                                   Style="max-width: 20px"
                                   OnClick="@(() => OpenVariableSelectorAsync(["bool", "int", "float"], v => context.Item.InputB = v))">
                    </MudIconButton>
                    <MudText>@(context.Item.InputB == 0 ? "Const B" : GetSelectedVarText(context.Item.InputB))</MudText>
                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Const B" Resizable="true" CellStyle="max-width: 100px">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.ConstB" Min="-1e9" Max="1e9"
                                 Disabled="@(!context.Item.Enabled || context.Item.InputB != 0)"/>
            </EditTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Factor" Resizable="true" CellStyle="max-width: 100px">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Factor" Min="-1e9" Max="1e9"
                                 Disabled="!context.Item.Enabled"/>
            </EditTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Offset" Resizable="true" CellStyle="max-width: 100px">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Offset" Min="-1e9" Max="1e9"
                                 Disabled="!context.Item.Enabled"/>
            </EditTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public List<MathBlock> MathBlocks { get; set; } = null!;
}
