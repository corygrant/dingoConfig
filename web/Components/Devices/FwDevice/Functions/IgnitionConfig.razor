@using domain.Devices.Functions
@using domain.Enums
@using web.Services
@inject NotificationService Notification
@typeparam TDevice where TDevice : domain.Interfaces.IDeviceConfigurable
@inherits FunctionComponentBase<TDevice>

<MudCard Outlined="true" Class="mb-2">
    <MudCardContent>
        <MudGrid Spacing="5">
            <MudItem>
                <MudCard Elevation="4" Style="width: 280px; height: 100%">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6" Class="mt-2">Enable</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudTextField @bind-Value="Ignition.Name"
                                      Label="Name"
                                      Variant="Variant.Outlined"/>
                        <MudSwitch @bind-Value="Ignition.Enabled"
                                   Label="Enabled"
                                   Color="Color.Primary"/>
                        <MudSelect T="IgnitionMode" @bind-Value="Ignition.Mode"
                                   Label="Mode"
                                   Variant="Variant.Outlined"
                                   Disabled="!Ignition.Enabled">
                            @foreach (IgnitionMode mode in Enum.GetValues(typeof(IgnitionMode)))
                            {
                                <MudSelectItem T="IgnitionMode" Value="@mode">@ModeText(mode)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudText Typo="Typo.caption" Class="mt-2">@ModeHelp(Ignition.Mode)</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem>
                <MudCard Elevation="4" Style="width: 320px; height: 100%">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6" Class="mt-2">Inputs</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudCard Elevation="4" Class="mb-2">
                            <MudCardContent>
                                <MudText Class="fst-italic">@IgnInputLabel(Ignition.Mode)</MudText>
                                <MudStack Row="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="(!Ignition.Enabled)"
                                                   Style="max-width: 20px"
                                                   OnClick="@(() => OpenVariableSelectorAsync(["bool"], v => Ignition.IgnInput = v))">
                                    </MudIconButton>
                                    <MudText>@GetSelectedVarText(Ignition.IgnInput)</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>

                        <MudCard Elevation="4" Class="mb-2">
                            <MudCardContent>
                                <MudText Class="fst-italic">@StartInputLabel(Ignition.Mode)</MudText>
                                <MudStack Row="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="(!Ignition.Enabled)"
                                                   Style="max-width: 20px"
                                                   OnClick="@(() => OpenVariableSelectorAsync(["bool"], v => Ignition.StartInput = v))">
                                    </MudIconButton>
                                    <MudText>@GetSelectedVarText(Ignition.StartInput)</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>

                        <MudCard Elevation="4" Class="mb-2">
                            <MudCardContent>
                                <MudText Class="fst-italic">Engine running</MudText>
                                <MudStack Row="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="(!Ignition.Enabled)"
                                                   Style="max-width: 20px"
                                                   OnClick="@(() => OpenVariableSelectorAsync(["bool"], v => Ignition.EngineRunInput = v))">
                                    </MudIconButton>
                                    <MudText>@GetSelectedVarText(Ignition.EngineRunInput)</MudText>
                                </MudStack>
                                <MudText Typo="Typo.caption">
                                    Releases the starter. Without it the starter only stops on the crank time limit.
                                </MudText>
                            </MudCardContent>
                        </MudCard>

                        <MudCard Elevation="4">
                            <MudCardContent>
                                <MudText Class="fst-italic">Stop (optional)</MudText>
                                <MudStack Row="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Search"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="(!Ignition.Enabled)"
                                                   Style="max-width: 20px"
                                                   OnClick="@(() => OpenVariableSelectorAsync(["bool"], v => Ignition.StopInput = v))">
                                    </MudIconButton>
                                    <MudText>@GetSelectedVarText(Ignition.StopInput)</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem>
                <MudCard Elevation="4" Style="width: 260px; height: 100%">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6" Class="mt-2">Starter</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudNumericField @key="@($"crank-{_refreshCounter}")"
                                         Value="@Ignition.MaxCrankTime"
                                         Label="Max crank time (ms)"
                                         Variant="Variant.Outlined"
                                         Disabled="!Ignition.Enabled"
                                         ValueChanged="@((int val) => MaxCrankTimeChanged(val))"/>
                        <MudText Typo="Typo.caption" Class="mt-2">
                            Hard limit on how long the starter may be engaged. After it expires the start
                            request has to be released before the starter can be engaged again.
                        </MudText>

                        <MudDivider Class="my-3"/>

                        <MudText Class="fst-italic">State</MudText>
                        <MudChip T="string"
                                 Variant="Variant.Outlined"
                                 Color="@StateColor(Ignition.State)"
                                 Size="Size.Small">
                            @StateText(Ignition.State)
                        </MudChip>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public Ignition Ignition { get; set; } = null!;

    private int _refreshCounter;

    private const int MinCrankTime = 500;
    private const int MaxCrankTimeMs = 30000;

    private static string ModeText(IgnitionMode mode) => mode switch
    {
        IgnitionMode.KeySwitch => "Key switch",
        IgnitionMode.StartButton => "Start button",
        _ => mode.ToString()
    };

    private static string ModeHelp(IgnitionMode mode) => mode switch
    {
        IgnitionMode.KeySwitch =>
            "The key ON position powers the ignition for as long as it is held there. " +
            "The START position is a separate momentary input.",
        IgnitionMode.StartButton =>
            "One press toggles the ignition. Pressed while the start condition is held it also cranks; " +
            "pressed on its own it only powers the ignition.",
        _ => string.Empty
    };

    private static string IgnInputLabel(IgnitionMode mode) => mode switch
    {
        IgnitionMode.KeySwitch => "Key ON position",
        IgnitionMode.StartButton => "Start button",
        _ => "Ignition input"
    };

    private static string StartInputLabel(IgnitionMode mode) => mode switch
    {
        IgnitionMode.KeySwitch => "Key START position",
        IgnitionMode.StartButton => "Start condition (e.g. clutch)",
        _ => "Start input"
    };

    private static string StateText(int state) => state switch
    {
        (int)IgnitionState.Off => "Off",
        (int)IgnitionState.Ignition => "Ignition",
        (int)IgnitionState.Cranking => "Cranking",
        (int)IgnitionState.Running => "Running",
        _ => state.ToString()
    };

    private static Color StateColor(int state) => state switch
    {
        (int)IgnitionState.Off => Color.Default,
        (int)IgnitionState.Ignition => Color.Info,
        (int)IgnitionState.Cranking => Color.Warning,
        (int)IgnitionState.Running => Color.Success,
        _ => Color.Default
    };

    private void MaxCrankTimeChanged(int value)
    {
        if (value < MinCrankTime || value > MaxCrankTimeMs)
        {
            Notification.NewWarning($"{Ignition.Name}.MaxCrankTime must be {MinCrankTime} to {MaxCrankTimeMs} ms");
        }
        Ignition.MaxCrankTime = Math.Clamp(value, MinCrankTime, MaxCrankTimeMs);
        _refreshCounter++;
    }
}
