@using web.Services
@using domain.Devices.Functions
@using domain.Enums
@inject NotificationService Notification

<MudDataGrid Items="@Inputs" Dense="true" Hover="true" Striped="false" EditMode="DataGridEditMode.Cell" ReadOnly="false"
             SortMode="SortMode.None" ColumnResizeMode="ResizeMode.Container" Virtualize="true" 
             FixedHeader="true" HorizontalScrollbar="true" Style="max-height: 400px;">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="#" StickyLeft="true" Editable="false" CellStyle="max-width: 100px"/>
        <PropertyColumn Property="x => x.Enabled" CellStyle="max-width: 100px">
            <EditTemplate>
                <MudCheckBox @bind-Value="context.Item.Enabled" Dense="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Name" CellStyle="max-width: 200px">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.State" Title="State" Editable="false" CellStyle="max-width: 100px">
            <CellTemplate>
                <MudChip T="string"
                         Variant="Variant.Outlined"
                         Color="@(context.Item.State ? Color.Success : Color.Default)"
                         Size="Size.Small" Style="min-width: 50px;">
                    @(context.Item.State ? "ON" : "OFF")
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Duty" Title="Duty (%)" Editable="false" Hidden="@(!Inputs.Any(i => i.Pwm))" CellStyle="max-width: 100px">
            <CellTemplate>
                @if (context.Item.Pwm)
                {
                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Style="min-width: 50px;">
                        @context.Item.Duty.ToString("F1")
                    </MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Frequency" Title="Frequency (Hz)" Editable="false" Hidden="@(!Inputs.Any(i => i.Pwm))" CellStyle="max-width: 100px">
            <CellTemplate>
                @if (context.Item.Pwm)
                {
                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Style="min-width: 50px;">
                        @context.Item.Frequency.ToString("F1")
                    </MudChip>
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Mode" CellStyle="max-width: 200px">
            <EditTemplate>
                <MudSelect T="domain.Enums.InputMode" @bind-Value="context.Item.Mode" Variant="Variant.Outlined" Dense="true"
                           Disabled="!context.Item.Enabled">
                    @foreach (domain.Enums.InputMode mode in Enum.GetValues(typeof(domain.Enums.InputMode)))
                    {
                        <MudSelectItem T="domain.Enums.InputMode" Value="@mode">@mode</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Invert" CellStyle="max-width: 100px">
            <EditTemplate>
                <MudCheckBox @bind-Value="context.Item.Invert" Dense="true" Disabled="!context.Item.Enabled"/>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Pull" CellStyle="max-width: 200px">
            <EditTemplate>
                <MudSelect T="InputPull" @bind-Value="context.Item.Pull" Variant="Variant.Outlined" Dense="true"
                           Disabled="!context.Item.Enabled">
                    @foreach (InputPull pull in Enum.GetValues(typeof(InputPull)))
                    {
                        <MudSelectItem T="InputPull" Value="@pull">@pull</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Debounce (ms)" Resizable="true" CellStyle="max-width: 100px">
            <EditTemplate>
                <MudNumericField @key="@($"debounce-{context.Item.Number}-{_refreshCounter}")"
                                 Value="@context.Item.DebounceTime"
                                 Disabled="!context.Item.Enabled"
                                 ValueChanged="@((int val) => OnDebounceChanged(context.Item, val))"/>
            </EditTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Pwm" Title="PWM" CellStyle="max-width: 100px">
            <EditTemplate>
                <MudCheckBox @bind-Value="context.Item.Pwm" Dense="true" Disabled="!context.Item.Enabled"/>
            </EditTemplate>
        </PropertyColumn>
        <TemplateColumn Title="PWM Min Pulse (us)" Resizable="true" CellStyle="max-width: 150px">
            <EditTemplate>
                <MudNumericField @key="@($"pwmMinPulse-{context.Item.Number}-{_refreshCounter}")"
                                 Value="@context.Item.PwmMinPulseUs"
                                 Disabled="@(!context.Item.Enabled || !context.Item.Pwm)"
                                 ValueChanged="@((int val) => OnPwmMinPulseChanged(context.Item, val))"/>
            </EditTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    [Parameter, EditorRequired]
    public List<DigitalInput> Inputs { get; set; } = null!;

    private int _refreshCounter = 0;

    private void OnDebounceChanged(DigitalInput item, int value)
    {
        const int min = 0;
        const int max = 1000;
        if (value < min || value > max)
        {
            Notification.NewWarning($"{item.Name}.DebounceTime must be {min} to {max}");
        }
        item.DebounceTime = Math.Clamp(value, min, max);
        _refreshCounter++;
    }

    private void OnPwmMinPulseChanged(DigitalInput item, int value)
    {
        const int min = 0;
        const int max = 10000;
        if (value < min || value > max)
        {
            Notification.NewWarning($"{item.Name}.PwmMinPulseUs must be {min} to {max}");
        }
        item.PwmMinPulseUs = Math.Clamp(value, min, max);
        _refreshCounter++;
    }
}